<?xml version="1.0"?>
<robot name="quadruped_arm">
  <!--
    Mesh-free Go2 + Franka model for Colab / Genesis.
    arm_mount_joint welds panda_link0 onto the Go2 base.
    Frame: Go2 +X is forward, +Z is up. Mount xyz=(-0.05, 0.0, 0.08) rpy=(0.0, 0.0, 0.0)
    sits slightly behind the base origin and above the chassis.
    Arm link masses are reduced (about 3 kg total) so the dog can stand.
    Replace this file's kinematics with scripts/merge_urdf.py once go2.urdf
    and panda.urdf are available. Suggested reset arm pose: panda_joint1=0.0, panda_joint2=-0.785, panda_joint3=0.0, panda_joint4=-2.356, panda_joint5=0.0, panda_joint6=1.571, panda_joint7=0.785.
  -->
  <link name="base">
    <inertial>
      <origin xyz="0.021112 0 -0.005366" rpy="0 0 0"/>
      <mass value="6.921"/>
      <inertia ixx="0.02448" ixy="0.00012166" ixz="0.0014849" iyy="0.098077" iyz="-0.0000312" izz="0.107"/>
    </inertial>
    <visual>
      <geometry><box size="0.376 0.12 0.114"/></geometry>
      <material name="base_mat"><color rgba="0.15 0.15 0.17 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.376 0.12 0.114"/></geometry>
    </collision>
  </link>
  <link name="FL_hip">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.678"/>
      <inertia ixx="0.001356" ixy="0" ixz="0" iyy="0.001356" iyz="0" izz="0.001356"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.04"/>
      </geometry>
      <material name="FL_hip_mat">
        <color rgba="0.25 0.25 0.28 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.04" length="0.04"/>
      </geometry>
    </collision>
  </link>
  <joint name="FL_hip_joint" type="revolute">
    <origin xyz="0.1934 0.0465 0" rpy="0 0 0"/>
    <parent link="base"/>
    <child link="FL_hip"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.0472" upper="1.0472" effort="23.7" velocity="30.1"/>
