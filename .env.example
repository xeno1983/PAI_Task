# Copy to .env (gitignored) or set in the shell before dvc / mlflow / docker compose.

PAI_MINIO_ENDPOINT=http://127.0.0.1:9000
PAI_MINIO_ACCESS_KEY=minioadmin
PAI_MINIO_SECRET_KEY=minioadmin
PAI_MINIO_DVC_BUCKET=pai-dvc
PAI_MINIO_MLFLOW_BUCKET=pai-mlflow

# Used by DVC and boto3 / MLflow S3 client
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
MLFLOW_S3_ENDPOINT_URL=http://127.0.0.1:9000

# Mender OTA (device_type must match the client)
PAI_MENDER_DEVICE_TYPE=go2-z1
